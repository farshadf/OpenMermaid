# Required for a public release build. Use the final HTTPS origin without a path.
PUBLIC_SITE_URL=https://openmermaid.example

# Keep false for previews and unconfigured deployments.
PUBLIC_INDEX_SITE=false

# Optional privacy-minimized, first-party aggregate template usage. The default
# remains off and retains connect-src 'none'. An aggregate build requires the
# separately deployed collector and an updated privacy notice.
PUBLIC_TELEMETRY_MODE=off

# Optional Docker self-hosting values. Use a source-derived tag for a reviewed
# release; Compose still binds only to host loopback.
OPEN_MERMAID_IMAGE_TAG=local
OPEN_MERMAID_BIND_PORT=8088

# Optional aggregate-telemetry deployment overlay values.
OPEN_MERMAID_TELEMETRY_IMAGE_TAG=local
OPEN_MERMAID_TELEMETRY_BIND_PORT=8091
OPEN_MERMAID_TELEMETRY_ORIGIN=https://openmermaid.example

# OPEN_MERMAID_SITE and OPEN_MERMAID_UPSTREAM belong in the host Caddy service
# environment, not in the browser build. See docs/SELF_HOSTING.md.
