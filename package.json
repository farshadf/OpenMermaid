{
  "name": "openmermaid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/inject-csp.mjs && node scripts/write-advertising-manifest.mjs && node scripts/dist-manifest.mjs write",
    "build:release": "node scripts/validate-release-env.mjs && astro check && astro build && node scripts/inject-csp.mjs && node scripts/write-advertising-manifest.mjs && node scripts/dist-manifest.mjs write",
    "preview": "astro preview",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:headed": "pnpm build && playwright test --headed",
    "social:generate": "node scripts/generate-social-image.mjs",
    "examples:generate": "node scripts/generate-static-examples.mjs",
    "examples:check": "node scripts/check-static-examples.mjs",
    "test:metadata": "node scripts/check-built-site.mjs && node scripts/check-advertising-build.mjs && node scripts/check-static-examples.mjs && node scripts/check-bundle-budgets.mjs && node scripts/dist-manifest.mjs verify",
    "test:advertising": "node scripts/check-advertising-build.mjs",
    "test:artifact": "node scripts/dist-manifest.mjs verify",
    "test:artifact-contract": "node scripts/test-dist-manifest.mjs",
    "test:build-reproducibility": "sh scripts/check-build-reproducibility.sh",
    "test:ci-config": "node scripts/check-ci-config.mjs",
    "test:deployment": "sh scripts/verify-deployment.sh",
    "test:deployment:browser": "OPEN_MERMAID_VERIFY_BROWSER=true sh scripts/verify-deployment.sh",
    "test:telemetry-deployment": "sh scripts/verify-telemetry-deployment.sh",
    "test:independence": "node scripts/check-independence.mjs",
    "test:licenses": "node scripts/check-licenses.mjs",
    "test:compliance": "pnpm test:licenses && pnpm sbom",
    "test:all": "pnpm check && pnpm test:coverage && pnpm test:e2e && pnpm test:metadata && pnpm test:independence && pnpm test:deployment:browser && pnpm test:compliance",
    "audit": "pnpm audit --prod",
    "lighthouse": "pnpm lighthouse:static && pnpm lighthouse:editor",
    "lighthouse:static": "lhci autorun --config=lighthouserc.static.json",
    "lighthouse:editor": "lhci autorun --config=lighthouserc.editor.json",
    "performance:crux": "node scripts/report-crux.mjs",
    "telemetry:start": "node services/telemetry/src/server.ts",
    "sbom": "node node_modules/@cyclonedx/cdxgen/bin/cdxgen.js -t js --no-recurse --no-install-deps --validate --fail-on-error --profile license-compliance --json-pretty -o reports/sbom.cdx.json ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "dompurify": "3.4.12",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "mermaid": "11.16.0",
    "preact": "10.29.7",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/preact": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.12.1",
    "@cyclonedx/cdxgen": "12.8.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/preact": "3.2.4",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "astro": "7.1.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "27.0.1",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
