---
interface Props {
  placement: 'banner' | 'content-rail' | 'editor-rail';
  enabled?: boolean;
  label?: string;
}

const { placement, enabled = false, label = 'Advertisement' } = Astro.props;
---

{
  enabled ? (
    <aside
      class:list={['ad-slot', `ad-slot--${placement}`]}
      aria-label={label}
      data-ad-placement={placement}
    >
      <slot />
    </aside>
  ) : null
}

<!--
  V1 intentionally renders nothing when disabled: no blank inventory, provider
  script, request, cookie, or layout shift. A future integration must put ads in
  a separate-origin sandboxed iframe and must never receive document data.
-->
