<section class="vitals-console" aria-labelledby="local-vitals-heading">
  <div class="vitals-console__header">
    <div>
      <p class="eyebrow">Private diagnostics</p>
      <h2 id="local-vitals-heading">This browser’s measurements</h2>
      <p class="muted">
        Nothing on this page sends performance data over the network. Local history is optional,
        bounded, and separate from your diagrams.
      </p>
    </div>
    <label class="vitals-toggle">
      <input id="vitals-history-toggle" type="checkbox" />
      <span>Save 30-day history in this browser</span>
    </label>
  </div>

  <p id="vitals-live-status" class="vitals-status" role="status" aria-live="polite">
    Starting current-visit measurement…
  </p>

  <div class="vitals-current" aria-label="Current visit Web Vitals">
    {
      [
        ['LCP', 'Largest Contentful Paint', '≤ 2.5 s'],
        ['INP', 'Interaction to Next Paint', '≤ 200 ms'],
        ['CLS', 'Cumulative Layout Shift', '≤ 0.1'],
        ['FCP', 'First Contentful Paint', '≤ 1.8 s'],
        ['TTFB', 'Time to First Byte', '≤ 800 ms'],
      ].map(([name, label, target]) => (
        <article class="vital-card" data-current-vital={name} data-rating="waiting">
          <div class="vital-card__meta">
            <span>{name}</span>
            <span>Good {target}</span>
          </div>
          <strong data-vital-value>Waiting</strong>
          <p>{label}</p>
        </article>
      ))
    }
  </div>

  <div class="vitals-history-heading">
    <div>
      <h3>Local 75th-percentile history</h3>
      <p id="vitals-history-summary" class="muted">
        Enable local history to keep measurements across visits.
      </p>
    </div>
    <div class="vitals-filters" aria-label="Performance history filters">
      <label>
        Page group
        <select id="vitals-page-filter">
          <option value="all">All pages</option>
          <option value="home">Home</option>
          <option value="editor">Editor</option>
          <option value="templates">Template index</option>
          <option value="template">Template pages</option>
          <option value="guides">Guide index</option>
          <option value="guide">Guide pages</option>
          <option value="about">About</option>
          <option value="privacy">Privacy</option>
          <option value="security">Security</option>
          <option value="performance">Performance</option>
          <option value="other">Other</option>
        </select>
      </label>
      <label>
        Viewport
        <select id="vitals-device-filter">
          <option value="all">All sizes</option>
          <option value="small">Small</option>
          <option value="large">Large</option>
        </select>
      </label>
    </div>
  </div>

  <div class="vitals-table-wrap">
    <table>
      <caption class="sr-only"> Locally stored Web Vitals grouped by metric </caption>
      <thead>
        <tr>
          <th scope="col">Metric</th>
          <th scope="col">Local p75</th>
          <th scope="col">Good samples</th>
          <th scope="col">Samples</th>
          <th scope="col">Signal</th>
        </tr>
      </thead>
      <tbody>
        {
          ['LCP', 'INP', 'CLS', 'FCP', 'TTFB'].map((name) => (
            <tr data-history-vital={name}>
              <th scope="row">{name}</th>
              <td data-history-p75>—</td>
              <td data-history-good>—</td>
              <td data-history-count>0</td>
              <td data-history-rating>Not measured</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="vitals-actions">
    <button id="vitals-download" class="button-secondary" type="button" disabled>
      Download aggregate report
    </button>
    <button id="vitals-clear" class="button-secondary" type="button" disabled>
      Clear performance history
    </button>
  </div>

  <aside class="vitals-boundary" aria-labelledby="vitals-boundary-heading">
    <h3 id="vitals-boundary-heading">What this can—and cannot—tell you</h3>
    <p>
      These measurements describe visits in this browser profile only. They are useful for local
      diagnosis, not population-wide claims. The sandboxed Mermaid preview is intentionally
      isolated, so this top-level collector cannot inspect activity inside its iframe. Production
      field health comes from Chrome UX Report data for the final canonical origin.
    </p>
  </aside>
</section>

