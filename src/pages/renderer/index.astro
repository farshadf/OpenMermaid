---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Open Mermaid isolated preview</title>
    <style is:inline>
      :root {
        color-scheme: light dark;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        block-size: 100%;
        margin: 0;
        overflow: hidden;
      }

      body {
        background: transparent;
      }

      .renderer-surface {
        position: relative;
        block-size: 100%;
        inline-size: 100%;
        overflow: hidden;
        outline: none;
        touch-action: none;
        user-select: none;
      }

      .renderer-surface:focus-visible {
        outline: 3px solid CanvasText;
        outline-offset: -3px;
      }

      .renderer-scene {
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        inline-size: max-content;
        transform-origin: 0 0;
        will-change: transform;
      }

      .renderer-scene svg {
        display: block;
        max-inline-size: none;
      }

      .renderer-staging {
        position: fixed;
        inset-block-start: -100000px;
        inset-inline-start: -100000px;
        visibility: hidden;
      }

      .visually-hidden {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (forced-colors: active) {
        .renderer-surface:focus-visible {
          outline-color: Highlight;
        }
      }
    </style>
  </head>
  <body>
    <main
      class="renderer-surface"
      data-renderer-surface
      tabindex="0"
      role="region"
      aria-label="Diagram preview. Drag or use arrow keys to pan. Use plus and minus to zoom, F to fit, and zero to reset."
    >
      <div class="renderer-scene" data-renderer-scene></div>
    </main>
    <p class="visually-hidden" data-renderer-status role="status" aria-live="polite">
      Loading the isolated diagram renderer…
    </p>
    <!--
      The exact inline bootstrap is build-hashed. strict-dynamic lets it load the local classic
      runtime even though this sandbox intentionally has an opaque origin.
    -->
    <script is:inline>
      (() => {
        const runtime = document.createElement('script');
        runtime.src = '/renderer/runtime.js';
        runtime.async = false;
        document.head.append(runtime);
      })();
    </script>
  </body>
</html>
