---
import Breadcrumbs from '../../components/static/Breadcrumbs.astro';
import { guides } from '../../data/guides';
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/guides/', label: 'Guides' },
] as const;
---

<BaseLayout
  title="Mermaid diagram guides"
  description="Practical, accessible guides to Mermaid syntax, diagram choice, privacy-aware sharing, and SVG or PNG export."
  canonicalPath="/guides/"
  breadcrumbs={breadcrumbs}
>
  <div class="shell">
    <Breadcrumbs items={breadcrumbs} />
    <header class="page-hero page-hero--compact">
      <p class="eyebrow">Explain ideas, not just syntax</p>
      <h1>Mermaid diagram guides</h1>
      <p class="lede">
        Learn how to choose, write, review, share, and export diagrams. Every guide includes
        readable source, a no-JavaScript example, common errors, and a path to related templates.
      </p>
    </header>

    <div class="guide-grid">
      {
        guides.map((guide) => (
          <article class="resource-card">
            <div class="resource-card__meta">
              <span>Guide</span>
              <span>{guide.readingMinutes} min read</span>
            </div>
            <h2>
              <a href={`/guides/${guide.slug}/`}>{guide.title}</a>
            </h2>
            <p>{guide.description}</p>
            <a class="text-link" href={`/guides/${guide.slug}/`}>
              Read guide <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>

    <aside class="callout">
      <h2>Accessibility is an authoring decision</h2>
      <p>
        Open Mermaid preserves source and surfaces accessible-title guidance, but it does not claim
        arbitrary user-authored diagrams are automatically accessible. Review the diagram, source,
        and publishing context together.
      </p>
      <a href="/guides/accessible-diagrams/">Read the accessibility guide</a>
    </aside>
  </div>
</BaseLayout>
